# Copy this file to .env and fill in your key.
#
# This project uses Groq by default (free tier, no credit card required).
# Get a free key at https://console.groq.com -> API Keys -> Create API Key

GROQ_API_KEY=your-key-here

# To use OpenAI or Anthropic instead, see the "Using a different LLM
# provider" section in README.md.
